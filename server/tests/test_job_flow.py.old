import uuid
from datetime import datetime, timedelta

from fastapi.testclient import TestClient

from app.main import app

client = TestClient(app)

API_PREFIX = "/api/v1"


def random_text(prefix: str) -> str:
    return f"{prefix}-{uuid.uuid4().hex[:8]}"


def lookup_id_by_name(path: str, name: str) -> int:
    response = client.get(path)
    assert response.status_code == 200, response.text
    items = response.json()
    for item in items:
        if item.get("Name") == name:
            return item["Id"]
    raise AssertionError(f"Lookup value '{name}' not found at {path}")


def create_job_spec(work_model_id: int, role_type_id: int) -> dict:
    payload = {
        "Position": random_text("Position"),
        "Company": random_text("Company"),
        "Link": f"https://example.com/{uuid.uuid4().hex}",
        "Description": random_text("Job description"),
        "WorkModelId": work_model_id,
        "RoleTypeId": role_type_id,
        "Created": datetime.utcnow().isoformat(),
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/job-specs", json=payload)
    assert response.status_code == 200, response.text
    return response.json()


def create_application() -> dict:
    payload = {
        "Applied": datetime.utcnow().isoformat(),
        "Notes": random_text("Application notes"),
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/applications", json=payload)
    assert response.status_code == 200, response.text
    return response.json()


def update_application(application_id: int, discarded_date: str) -> dict:
    payload = {
        "Id": application_id,
        "Applied": datetime.utcnow().isoformat(),
        "Discarded": discarded_date,
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/applications", json=payload)
    assert response.status_code == 200, response.text
    return response.json()


def create_interview(application_id: int) -> dict:
    payload = {
        "ApplicationId": application_id,
        "Scheduled": (datetime.utcnow() + timedelta(days=1)).isoformat(),
        "Notes": random_text("Interview notes"),
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/interviews", json=payload)
    assert response.status_code == 200, response.text
    return response.json()


def delete_job_spec(job_spec_id: int) -> None:
    response = client.delete(f"{API_PREFIX}/roles/job-specs/{job_spec_id}")
    assert response.status_code == 200, response.text


def delete_application(application_id: int) -> None:
    response = client.delete(f"{API_PREFIX}/roles/applications/{application_id}")
    assert response.status_code == 200, response.text


def delete_interview(interview_id: int) -> None:
    response = client.delete(f"{API_PREFIX}/roles/interviews/{interview_id}")
    assert response.status_code == 200, response.text


def test_create_basic_job_spec() -> None:
    work_model_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/work-models", "Hybrid")
    role_type_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/role-types", "Contract")

    job_spec = create_job_spec(work_model_id, role_type_id)
    assert job_spec["Position"].startswith("Position-")
    assert job_spec["Company"].startswith("Company-")
    assert job_spec["Link"].startswith("https://example.com/")
    assert job_spec["Description"].startswith("Job description-")
    assert job_spec["WorkModelId"] == work_model_id
    assert job_spec["RoleTypeId"] == role_type_id

    delete_job_spec(job_spec["Id"])


def test_create_job_spec_with_linked_application() -> None:
    work_model_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/work-models", "Hybrid")
    role_type_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/role-types", "Contract")

    application = create_application()
    job_spec = create_job_spec(work_model_id, role_type_id)

    payload = {
        "Id": job_spec["Id"],
        "ApplicationId": application["Id"],
        "Position": job_spec["Position"],
        "Company": job_spec.get("Company"),
        "Link": job_spec.get("Link"),
        "Description": job_spec.get("Description"),
        "WorkModelId": work_model_id,
        "RoleTypeId": role_type_id,
        "Created": job_spec["Created"],
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/job-specs", json=payload)
    assert response.status_code == 200, response.text
    updated_job_spec = response.json()
    assert updated_job_spec["ApplicationId"] == application["Id"]

    delete_job_spec(updated_job_spec["Id"])
    delete_application(application["Id"])


def test_create_job_spec_with_discarded_application() -> None:
    work_model_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/work-models", "Hybrid")
    role_type_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/role-types", "Contract")

    job_spec = create_job_spec(work_model_id, role_type_id)
    application = create_application()

    update_payload = {
        "Id": job_spec["Id"],
        "ApplicationId": application["Id"],
        "Position": job_spec["Position"],
        "Company": job_spec.get("Company"),
        "Link": job_spec.get("Link"),
        "Description": job_spec.get("Description"),
        "WorkModelId": work_model_id,
        "RoleTypeId": role_type_id,
        "Created": job_spec["Created"],
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/job-specs", json=update_payload)
    assert response.status_code == 200, response.text

    discarded_date = (datetime.utcnow() + timedelta(days=2)).isoformat()
    updated_application = update_application(application["Id"], discarded_date)
    assert updated_application["Discarded"] == discarded_date

    delete_job_spec(job_spec["Id"])
    delete_application(application["Id"])


def test_create_job_spec_with_interview() -> None:
    work_model_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/work-models", "Hybrid")
    role_type_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/role-types", "Contract")

    job_spec = create_job_spec(work_model_id, role_type_id)
    application = create_application()

    payload = {
        "Id": job_spec["Id"],
        "ApplicationId": application["Id"],
        "Position": job_spec["Position"],
        "Company": job_spec.get("Company"),
        "Link": job_spec.get("Link"),
        "Description": job_spec.get("Description"),
        "WorkModelId": work_model_id,
        "RoleTypeId": role_type_id,
        "Created": job_spec["Created"],
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/job-specs", json=payload)
    assert response.status_code == 200, response.text

    interview = create_interview(application["Id"])
    assert interview["ApplicationId"] == application["Id"]

    delete_interview(interview["Id"])
    delete_job_spec(job_spec["Id"])
    delete_application(application["Id"])


def test_create_job_spec_with_interview_and_discarded_application() -> None:
    work_model_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/work-models", "Hybrid")
    role_type_id = lookup_id_by_name(f"{API_PREFIX}/roles/lookup/role-types", "Contract")

    job_spec = create_job_spec(work_model_id, role_type_id)
    application = create_application()

    payload = {
        "Id": job_spec["Id"],
        "ApplicationId": application["Id"],
        "Position": job_spec["Position"],
        "Company": job_spec.get("Company"),
        "Link": job_spec.get("Link"),
        "Description": job_spec.get("Description"),
        "WorkModelId": work_model_id,
        "RoleTypeId": role_type_id,
        "Created": job_spec["Created"],
        "IsActive": True,
    }
    response = client.post(f"{API_PREFIX}/roles/job-specs", json=payload)
    assert response.status_code == 200, response.text

    interview = create_interview(application["Id"])
    assert interview["ApplicationId"] == application["Id"]

    discarded_date = (datetime.utcnow() + timedelta(days=3)).isoformat()
    updated_application = update_application(application["Id"], discarded_date)
    assert updated_application["Discarded"] == discarded_date

    delete_interview(interview["Id"])
    delete_job_spec(job_spec["Id"])
    delete_application(application["Id"])
